{
  "name": "@amsterdam/react-maps",
  "version": "1.1.1",
  "description": "ReactJS wrapped around Leaflet",
  "license": "MPL-2.0",
  "author": "Gemeente Amsterdam",
  "homepage": "https://github.com/Amsterdam/react-maps#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amsterdam/react-maps.git"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "es",
    "lib"
  ],
  "jsnext:main": "./es/index.js",
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "scripts": {
    "clean": "rm -rf es lib",
    "build:ts": "tsc",
    "build:ts:es": "tsc --project tsconfig.es.json",
    "build": "npm run clean && npm run build:ts && npm run build:ts:es",
    "start": "webpack serve",
    "lint": "eslint ./ --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "publish": "lerna publish"
  },
  "peerDependencies": {
    "leaflet": ">=1.9",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.9",
    "@types/leaflet-draw": "^1.0.11",
    "@types/node": "^20.12.4",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "css-loader": "^6.11.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "geojson": "^0.5.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "leaflet": "^1.9.4",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.0.0",
    "react-test-renderer": "^18.0.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^4.7.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    ".*.{ts,tsx}": [
      "eslint",
      "git add"
    ]
  }
}
